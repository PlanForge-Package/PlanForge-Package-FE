# Keep LF on checkout too, to match Prettier (endOfLine: lf) and .editorconfig.
* text=auto eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated files are collapsed in diffs.
pnpm-lock.yaml linguist-generated=true -diff
